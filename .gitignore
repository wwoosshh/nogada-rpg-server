# 의존성
node_modules/
.pnpm-store/

# 빌드 산출물
dist/
build/
out/
*.tsbuildinfo

# packages/data 가 CSV 에서 생성하는 JSON (빌드 타임 생성물)
packages/data/src/generated/

# 구매 에셋 — 재배포 금지 조항이 흔하므로 버전 관리에서 제외한다.
# 출처와 구매처는 assets/CREDITS.md 에만 기록한다.
assets/licensed/

# 환경변수 — 서버 주소, DB 접속 정보
.env
.env.*
!.env.example

# Vite / 번들러 캐시
.vite/
.turbo/
.cache/

# 테스트
coverage/

# Capacitor 빌드 산출물 (android/ 자체는 커밋 대상)
android/app/build/
android/build/
android/.gradle/
android/local.properties
ios/App/build/
ios/App/Pods/

# Tiled 맵 에디터 설치 위치 (프로젝트 산출물이 아님)
tail/

# 에디터
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# 로그
*.log
npm-debug.log*
pnpm-debug.log*

# 라이선스 에셋의 public/ 복사본.
# 빌드 산출물에는 포함되어야 하지만 리포지토리에 올리면 재배포에 해당한다
# (Pipoya: "Not redistribute or resell this assets").
# 복원 방법은 assets/CREDITS.md 참조.
apps/client/public/tilesets/
apps/client/public/sprites/
apps/client/public/icons/

# Tiled 에디터 세션 상태 (사용자별)
*.tiled-session
